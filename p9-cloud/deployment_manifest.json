{
  "version": "p9-deployment-v2",
  "status": "BOUNDED_ADVISORY_REFERENCE",
  "live_readback": "live_deployment_readback.json",
  "region": "us-west-2",
  "function": {
    "name": "ck-p9-evaluator",
    "handler": "live_lambda_handler.lambda_handler",
    "memory_mib": 256,
    "timeout_seconds": 30,
    "reserved_concurrency": null,
    "effective_account_concurrency_ceiling": null,
    "max_coordinator_in_flight": 1,
    "request_budget_ms": 8000,
    "provisioned_concurrency": 0,
    "function_url": false,
    "network_calls": false
  },
  "logs": {
    "retention_days": 14
  },
  "limits": {
    "max_invocations": 1000,
    "max_request_bytes": 16384,
    "max_response_bytes": 16384,
    "incremental_aws_cost_usd": 5
  },
  "cockroach": {
    "cluster": "cockroach-kernel",
    "database": "cockroach_kernel",
    "schema": "ck",
    "runtime_user": "ck_runtime",
    "region": "us-west-2",
    "ca_path_class": "PROJECT_LOCAL_IGNORED_RUNTIME_ONLY",
    "checkpoint_persistence": "ADAPTER_READY_READBACK_REQUIRED"
  },
  "managed_mcp": {
    "authentication": "OAUTH",
    "cluster_scope": "cockroach-kernel",
    "access": "READ_ONLY",
    "view": "ck.mcp_receipt_view",
    "max_rows": 64
  },
  "claims_boundary": {
    "lambda_is_advisory": true,
    "local_verifier_is_authority": true,
    "mcp_write_ddl_recovery_authority": false
  }
}
