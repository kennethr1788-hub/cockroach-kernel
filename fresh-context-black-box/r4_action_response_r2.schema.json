{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action": {
      "enum": ["RUN_RECOVER", "STOP"]
    },
    "case_id": {
      "enum": ["PC-01", "PC-02", "PC-03"]
    },
    "rationale": {
      "maxLength": 512,
      "type": "string"
    }
  },
  "required": ["action", "case_id", "rationale"],
  "type": "object"
}
