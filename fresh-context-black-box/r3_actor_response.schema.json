{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action": {
      "enum": ["RUN_RECOVER", "STOP"]
    },
    "argv": {
      "items": {
        "type": "string"
      },
      "maxItems": 16,
      "minItems": 0,
      "type": "array"
    },
    "rationale": {
      "maxLength": 512,
      "type": "string"
    }
  },
  "required": ["action", "argv", "rationale"],
  "type": "object"
}
