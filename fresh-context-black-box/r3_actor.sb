(version 1)
(deny default)
(debug deny)

; The staged Python runtime and installed console script are the only executable
; actor surfaces. Forking is required for exec, but subsequent executable
; selection remains constrained by process-exec.
(allow process-exec
  (literal (param "PYTHON"))
  (literal (param "ENTRYPOINT")))
(allow process-fork)
(allow process-info*)
(allow signal)

; CPython and the macOS loader require these read-only kernel/runtime services.
(allow sysctl*)
(allow mach*)
(allow ipc*)
(allow system-socket)

; macOS loader/runtime reads are permitted while all user, mounted-volume,
; application, optional-software, and general temporary namespaces are removed.
; Only the exact staged roots below are reopened inside /private/tmp.
(allow file-read*)
(deny file-read*
  (subpath "/Users")
  (subpath "/Volumes")
  (subpath "/Applications")
  (subpath "/opt")
  (subpath "/home")
  (subpath "/cores")
  (subpath "/private/tmp"))
(allow file-read-metadata
  (literal "/")
  (literal "/Users")
  (literal "/Volumes")
  (literal "/private")
  (literal "/private/tmp")
  (literal (param "CAMPAIGN_ROOT")))
(allow file-read*
  (subpath (param "TOOLCHAIN_ROOT"))
  (subpath (param "PACKAGE_ROOT"))
  (subpath (param "PUBLIC_ROOT"))
  (subpath (param "HOME_ROOT"))
  (subpath (param "REQUEST_ROOT"))
  (subpath (param "WORKSPACE_ROOT"))
  (subpath (param "REPRESENTATION_ROOT"))
  (subpath (param "CUSTODY_ROOT"))
  (subpath (param "OUTPUT_ROOT"))
  (subpath (param "TEMP_ROOT")))

; Product mutation authority is limited to successor, one-use custody, output,
; and its empty temporary directory. Representations and public docs are read-only.
(allow file-write*
  (subpath (param "WORKSPACE_ROOT"))
  (subpath (param "CUSTODY_ROOT"))
  (subpath (param "OUTPUT_ROOT"))
  (subpath (param "TEMP_ROOT")))

(deny network*)
