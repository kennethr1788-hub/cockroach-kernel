{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "server",
    "operations_attempted",
    "read_query_exact",
    "read_succeeded",
    "read_row_count",
    "linkages",
    "credential_material_observed",
    "unexpected_tool_used",
    "limitations"
  ],
  "properties": {
    "status": {"type": "string", "enum": ["GREEN", "BLOCKED"]},
    "server": {"type": "string", "const": "cockroachdb-cloud"},
    "operations_attempted": {"type": "integer", "minimum": 0, "maximum": 1},
    "read_query_exact": {"type": "boolean"},
    "read_succeeded": {"type": "boolean"},
    "read_row_count": {"type": ["integer", "null"], "minimum": 0, "maximum": 2},
    "linkages": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "receipt_hash", "status", "event_hash"],
        "properties": {
          "task_id": {"type": "string"},
          "receipt_hash": {"type": "string"},
          "status": {"type": "string"},
          "event_hash": {"type": "string"}
        }
      }
    },
    "credential_material_observed": {"type": "boolean"},
    "unexpected_tool_used": {"type": "boolean"},
    "limitations": {"type": "array", "maxItems": 4, "items": {"type": "string"}}
  }
}
