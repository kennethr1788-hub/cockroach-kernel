include README.md pyproject.toml
recursive-include cockroach_kernel *.py
recursive-include p7-recovery *.py *.json *.sql
recursive-include p9-cloud *.py *.json *.sql
recursive-include p4-verifier *.py *.json
prune .hardening-runtime
prune .pdh3-runtime
prune .s3-runtime
prune build
prune heap_profiler
global-exclude *.tgz
global-exclude *.tar.gz
global-exclude *.zip
