# Project-local test runtime; never publish the downloaded database binary.
p2-cleanroom/vendor/

# S3 project-local cloud CLIs, temporary OAuth/session caches, and certificates.
.s3-runtime/

# Raw S3 preflight/run evidence remains local; bounded receipts carry hashes.
s3-live-smoke-*/
s3-local-smoke-*/
s3-local-offline-refusal-*/
s3-*.stdout

# Hardening campaign build roots and provider-response scratch stay local.
.hardening-runtime/
build/
*.egg-info/

# EV1 genuine-use task roots, dependency caches, and raw task evidence stay local.
.ev1-runtime/

# PDH-3 paid-campaign archives, raw scans, provider responses, and retrieved
# evidence stay local; canonical receipts bind them by SHA-256.
.pdh3-runtime/

# Python compilation residue is never release evidence.
__pycache__/
